<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.lz007001cn</groupId>
    <artifactId>veriqra</artifactId>
    <name>Veriqra</name>
    <description>Software Test &amp; Quality Management Platform</description>
    <url>https://veriqra.xyz</url>
    <version>0.9.0-SNAPSHOT</version>

    <packaging>war</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.13.4</junit.version>
        <test.excludedGroups>mysql</test.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.21.6</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.21.6</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-core</artifactId>
            <version>10.1.60</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.7.0</version>
            <scope>runtime</scope>
            <exclusions>
                <!-- Native JDBC only; X DevAPI is outside this project. -->
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/*.local.properties</exclude>
                    <exclude>**/.gitkeep</exclude>
                    <exclude>build-info.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes><include>build-info.properties</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>9.0.1</version>
                <executions><execution><goals><goal>revision</goal></goals></execution></executions>
                <configuration>
                    <commitIdGenerationMode>full</commitIdGenerationMode>
                    <dateFormat>yyyy-MM-dd'T'HH:mm:ssXXX</dateFormat>
                    <dateFormatTimeZone>UTC</dateFormatTimeZone>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git.commit.id.full$</includeOnlyProperty>
                        <includeOnlyProperty>^git.build.time$</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>version-web-assets</id>
                        <phase>generate-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target xmlns:unless="ant:unless">
                                <!-- Hash only release-owned resources, using sorted relative paths. -->
                                <checksum algorithm="SHA-256" totalproperty="asset.digest"
                                          todir="${project.build.directory}/asset-checksums" forceoverwrite="true">
                                    <fileset dir="${project.basedir}/src/main/webapp"
                                             includes="assets/js/**/*.js,assets/css/**/*.css,admin/*.js,admin/*.css,i18n/*.json"/>
                                </checksum>
                                <condition property="asset.git.available">
                                    <matches string="${git.commit.id.full}" pattern="^[0-9a-f]{40}$"/>
                                </condition>
                                <condition property="asset.commit" value="${git.commit.id.full}" else="dev">
                                    <isset property="asset.git.available"/>
                                </condition>
                                <echo level="warning" unless:set="asset.git.available">Git release metadata unavailable; using a content-derived development asset token.</echo>
                                <property name="asset.version" value="${asset.commit}-${asset.digest}"/>
                                <mkdir dir="${project.build.outputDirectory}"/>
                                <echo file="${project.build.outputDirectory}/asset-version.properties" encoding="UTF-8">token=${asset.version}
digest=${asset.digest}
</echo>
                                <!-- Keep source HTML unchanged, and regenerate copies on every build. -->
                                <delete dir="${project.build.directory}/versioned-webapp" quiet="true"/>
                                <copy todir="${project.build.directory}/versioned-webapp">
                                    <fileset dir="${project.basedir}/src/main/webapp" includes="**/*.html"/>
                                </copy>
                                <replaceregexp flags="g" encoding="UTF-8"
                                               match="((?:src|href)=[&quot;'])((?:assets/(?:js|css)/|admin/)[^&quot;'?#]+\.(?:js|css))(\?[^&quot;'#]*)(#[^&quot;']*)?([&quot;'])"
                                               replace="\1\2\3&amp;amp;v=${asset.version}\4\5">
                                    <fileset dir="${project.build.directory}/versioned-webapp" includes="**/*.html"/>
                                </replaceregexp>
                                <replaceregexp flags="g" encoding="UTF-8"
                                               match="((?:src|href)=[&quot;'])((?:assets/(?:js|css)/|admin/)[^&quot;'?#]+\.(?:js|css))(#[^&quot;']*)?([&quot;'])"
                                               replace="\1\2?v=${asset.version}\3\4">
                                    <fileset dir="${project.build.directory}/versioned-webapp" includes="**/*.html"/>
                                </replaceregexp>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <failOnMissingWebXml>true</failOnMissingWebXml>
                    <!-- Directory placeholders are not application resources. -->
                    <packagingExcludes>**/.gitkeep,**/*.local.properties</packagingExcludes>
                    <warSourceExcludes>**/*.local.properties,**/*.html</warSourceExcludes>
                    <webResources>
                        <resource>
                            <directory>${project.build.directory}/versioned-webapp</directory>
                            <includes><include>**/*.html</include></includes>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>mysql-tests</id>
            <properties>
                <!-- Explicit opt-in: missing test configuration fails the build. -->
                <test.excludedGroups>none</test.excludedGroups>
            </properties>
        </profile>
    </profiles>

</project>
